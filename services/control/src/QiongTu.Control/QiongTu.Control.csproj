<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>QiongTu.Control</AssemblyName>
    <RootNamespace>QiongTu.Control</RootNamespace>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\packages\contracts\dotnet\QiongTu.Contracts\QiongTu.Contracts.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Migrations\Business\*.sql" />
  </ItemGroup>
  <Target Name="PublishIsolatedImageProbe" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' == 'win-x64' and '$(SkipImageProbePublish)' != 'true'">
    <PropertyGroup>
      <ImageProbePublishDirectory>$(PublishDir)image-probe\</ImageProbePublishDirectory>
    </PropertyGroup>
    <MSBuild
      Projects="..\..\..\image-probe\src\QiongTu.ImageProbe\QiongTu.ImageProbe.csproj"
      Targets="Publish"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;PublishDir=$(ImageProbePublishDirectory);SelfContained=true;PublishSingleFile=true;IncludeNativeLibrariesForSelfExtract=true;RestoreLockedMode=true;SkipImageProbePublish=true" />
    <Error
      Condition="!Exists('$(ImageProbePublishDirectory)QiongTu.ImageProbe.exe')"
      Text="The isolated CAS image probe was not published to the fixed image-probe product directory." />
  </Target>
</Project>
